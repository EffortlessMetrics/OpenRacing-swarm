[Unit]
Description=OpenRacing Service
Documentation=https://github.com/EffortlessMetrics/OpenRacing
After=graphical-session.target
Wants=graphical-session.target

[Service]
# wheeld does not implement sd_notify, so Type=notify would leave the unit
# hanging until TimeoutStartSec and then fail. `--service` is the Windows SCM
# flag (it redirects logging to a file); on Linux wheeld runs the daemon with
# no arguments and logs to the journal via stdout.
Type=simple
ExecStart=%INSTALL_PATH%/bin/wheeld
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=false
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=false
RestrictSUIDSGID=true
RemoveIPC=true

# Device access and real-time scheduling.
#
# This is a *user* unit (installed to the systemd user manager), which limits
# what can be requested here:
#
#   - SupplementaryGroups= is documented as available only for system services
#     and unsupported in per-user instances, so it is not set. HID access comes
#     instead from the udev rules in 99-racing-wheel-suite.rules, which tag
#     racing devices with uaccess for the logged-in user. Adding the account to
#     the input/plugdev groups covers seat-less setups; install.sh checks group
#     membership and reports what is missing.
#
#   - AmbientCapabilities= in a per-user instance implicitly enables
#     PrivateUsers=, so CAP_SYS_NICE would only be held inside a user
#     namespace -- which does not lift the host RLIMIT_RTPRIO check that
#     sched_setscheduler() actually needs -- while the implied user namespace
#     would interfere with the /dev access this service depends on. It is
#     therefore not set.
#
# RT scheduling: crates/openracing-scheduler/src/linux.rs requests SCHED_FIFO
# via sched_setscheduler() directly, and the failure path in
# crates/engine/src/scheduler.rs notes that an rtkit fallback is not yet
# implemented. So RT priority currently depends on the account's RLIMIT_RTPRIO
# (commonly granted through limits.conf or a `realtime` group). If RT priority
# proves unobtainable for user services in practice, the fix is either to
# implement the org.freedesktop.RealtimeKit1 request or to ship a system unit;
# granting the capability here would not achieve it.
# RestrictRealtime=false below leaves the seccomp path open either way.

# Working directory and state
WorkingDirectory=%INSTALL_PATH%
StateDirectory=racing-wheel-suite
ConfigurationDirectory=racing-wheel-suite
LogsDirectory=racing-wheel-suite
RuntimeDirectory=racing-wheel-suite

# Environment
Environment=RUST_LOG=info
Environment=WHEEL_CONFIG_DIR=%INSTALL_PATH%/config
Environment=WHEEL_PROFILES_DIR=%INSTALL_PATH%/profiles

[Install]
WantedBy=default.target